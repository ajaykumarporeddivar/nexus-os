generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Lead Management (SME Council v1) ─────────────────────────────────────────

enum LeadStatus {
  new
  enriched
  scored
  routed
  in_outreach
  converted
  disqualified
  dlq
}

model Lead {
  id          String     @id @default(cuid())
  userId      String?    // linked if they signed up
  email       String
  name        String?
  phone       String?
  company     String?
  role        String?    // job title / seniority

  // ICP scoring (SME-5)
  icpScore        Int?        // 0–100
  scoreConfidence Float?      // 0.0–1.0
  scoreRationale  Json?       // [{factor, direction, weight}]
  scoredAt        DateTime?

  // Pipeline status (SME-2)
  status          LeadStatus  @default(new)

  // Routing (SME-2 / SME-4)
  routingDecision String?     // "hot_queue" | "nurture" | "disqualified"
  assignedRep     String?
  routedAt        DateTime?

  // Enrichment (SME-4)
  firmographic    Json?       // {companySize, industry, location, linkedinUrl}
  enrichedAt      DateTime?
  enrichmentFailed Boolean    @default(false)

  // Consent (SME-6 / SME-11 consent_gate)
  consentCaptured Boolean     @default(false)
  consentAt       DateTime?
  consentSource   String?     // "landing_form" | "pipeline_complete" | "api"

  // Attribution (SME-13)
  source          String?     // "landing_page" | "pipeline_complete" | "api" | "referral"
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  pipelineRunId   String?     // links back to pipeline execution for ROI

  // Disqualification (SME-9)
  disqualifiedAt     DateTime?
  disqualificationReason String?

  // Rep override audit (SME-11 rep_override_audit)
  repOverrideScore  Int?
  repOverrideReason String?
  repOverrideAt     DateTime?
  repOverrideBy     String?

  // DLQ (SME-8)
  dlqAt     DateTime?
  dlqReason String?
  dlqRetries Int      @default(0)

  // Cost attribution (SME-13)
  scoringCostUsd Float?
  enrichCostUsd  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@index([icpScore])
  @@index([createdAt])
  @@index([userId])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  image           String?
  emailVerified   DateTime?
  plan            String    @default("free")
  planActivatedAt DateTime?
  razorpayOrderId String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  leadScore       Int       @default(0)
  lastActiveAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  executions    Execution[]
  apiKeys       ApiKey[]
  auditEvents   AuditEvent[]
  subscriptions Subscription[]
  workspaces    Workspace[]
  leads         Lead[]

  @@index([plan])
}

model Workspace {
  id               String   @id @default(cuid())
  name             String
  type             String   @default("client") // client | feature | internal | personal
  description      String?
  context          String?  @db.Text
  emoji            String   @default("📁")
  color            String   @default("acid")
  ownerId          String?
  industryCategory String?  // denormalized shortcut; synced from intelligenceProfile.primaryIndustry
  // Agency business layer
  monthlyRetainer  Int?     // retainer amount in INR (e.g. 500000 = ₹5K/mo)
  portalSlug       String?  @unique  // URL-safe slug for client portal
  portalToken      String?  // secret token for gated portal access
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner               User?                        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  executions          Execution[]
  intelligenceProfile WorkspaceIntelligenceProfile?
  ideas               WorkspaceIdea[]
  generationJobs      WorkspaceGenerationJob[]
  clientAgents        ClientAgent[]
  integrations        WorkspaceIntegration[]

  @@index([ownerId])
  @@index([industryCategory])
  @@index([portalSlug])
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  plan        String
  orderId     String   @unique
  paymentId   String   @unique
  amount      Int
  currency    String   @default("INR")
  status      String   @default("active")
  activatedAt DateTime @default(now())
  expiresAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id           String    @id @default(cuid())
  userId       String
  encryptedKey String    @db.Text
  keyHint      String
  isValid      Boolean   @default(true)
  lastUsed     DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Execution {
  id               Int      @id @default(autoincrement())
  userId           String?
  workspaceId      String?
  sessionId        String
  inputSnippet     String   @db.Text
  clientName       String
  phases           String[]
  tokens           Int      @default(0)
  calls            Int      @default(0)
  score            Float?
  passed           Boolean?
  status           String   @default("COMPLETE")
  fileCount        Int      @default(0)
  zipKey           String?
  fatigueZone      String   @default("green")   // AAS v4: green|yellow|red at decision time
  attributionConf  Float?                        // AAS v4: 0–1, gates rule updates in Phase 08
  irreversible     Boolean  @default(false)       // AAS v4: true = 2× confidence gate
  timingAdv        Float    @default(0.5)         // AAS v4 RP_score: 1=pioneer, 0.5=field consensus, 0.1=late mover
  sourceIdeaId     String?                        // WorkspaceIdea.id if pipeline launched from an idea
  createdAt        DateTime @default(now())

  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace     Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  agentOutputs  AgentOutput[]
  auditEvents   AuditEvent[]
  workspaceIdeas WorkspaceIdea[]

  @@index([sessionId])
  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
  @@index([status])
}

model AgentOutput {
  id          String   @id @default(cuid())
  executionId Int
  agentId     String
  filePath    String
  content     String   @db.Text
  tokens      Int      @default(0)
  createdAt   DateTime @default(now())

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
}

model VaultPrompt {
  id          String   @id @default(cuid())
  vaultItemId String
  userId      String?
  title       String
  content     String   @db.Text
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vaultItemId, version])
  @@index([vaultItemId, isActive])
}

// ── Proposal Management (SME Council v2 — 13-SME spec) ───────────────────────

enum ProposalStage {
  intake
  bid_decision
  scoping
  drafting
  pricing
  review
  approved
  delivered
  no_bid
  dlq
}

enum BidDecision {
  pending
  bid
  no_bid
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum WinLossOutcome {
  won
  lost
  no_decision
}

model Proposal {
  id              String         @id @default(cuid())
  rfpRef          String?        // e.g. RFQ-2025-0441 — client-provided reference
  pipelineRunId   String?        // ROI attribution link (SME-13)

  // Client & RFP (SME-6 PII classification: PII-DIRECT)
  clientName      String?
  clientEmail     String?
  clientCompany   String?
  rfpTitle        String
  rfpText         String         @db.Text  // raw RFP document
  ndaActive       Boolean        @default(false)   // nda_access_gate trigger
  consentCaptured Boolean        @default(false)   // DPDP §6.16

  // Deal economics (SME-11 high_value_review_gate: >₹10L)
  dealValueInr    Decimal?       @db.Decimal(14,2)
  dealValueUsd    Decimal?       @db.Decimal(14,2)

  // Pipeline stage (SME-2)
  stage           ProposalStage  @default(intake)
  deadline        DateTime?      // RFP submission deadline — drives deadline_dlq_monitor
  deadlineAlertSentAt DateTime?

  // Bid/No-bid (SME-4 bid-decision-agent)
  bidDecision        BidDecision @default(pending)
  bidFitScore        Int?        // 0–100
  winProbabilityPct  Int?        // 0–100
  bidRationale       Json?       // [{factor, direction, confidence}] top-3 required
  bidDecisionAt      DateTime?
  bidDecisionBy      String?     // "agent" | userId for human override

  // Scoping (SME-2 scoping stage)
  scopeOutline        String?    @db.Text
  effortEstimateDays  Int?
  scopedAt            DateTime?

  // Drafting (SME-5 drafting-agent)
  proposalDraft       String?    @db.Text
  draftVersion        Int        @default(0)
  revisionDepth       Int        @default(0)  // revision_depth_halt: halt at 3
  sourceReferences    Json?      // [KB articles, templates] used by drafting-agent
  hallucinationFlags  Json?      // sections flagged for human review
  marginLeakScanPassed Boolean   @default(false) // margin_leak_guard
  draftedAt           DateTime?

  // Pricing (SME-5 pricing-agent)
  pricingModel        Json?      // [{item, qty, rateInr, rate_source}]
  pricingTotalInr     Decimal?   @db.Decimal(14,2)
  pricingFloorMet     Boolean    @default(false)  // pricing_floor_gate
  pricedAt            DateTime?

  // Review & approval (SME-11 proposal_mutation_gate)
  approvalStatus      ApprovalStatus @default(pending)
  approvedBy          String?
  approvedAt          DateTime?
  rejectionReason     String?
  secondReviewRequired Boolean   @default(false)  // high_value_review_gate
  secondApprovedBy    String?
  secondApprovedAt    DateTime?
  mutationBlockedAt   DateTime?  // last time proposal_mutation_gate fired

  // Delivery
  deliveredAt         DateTime?
  deliveryMethod      String?    // "email" | "portal" | "manual"

  // Win/loss outcome (SME-13 ROI loop)
  outcome             WinLossOutcome?
  outcomeAt           DateTime?
  lossReason          String?
  qualityScoreAtSubmission Int?  // review-agent score at delivery

  // LLM cost attribution (SME-13)
  llmCostUsd          Float?
  agentCostBreakdown  Json?      // {intake, bidDecision, drafting, pricing, review}

  // DLQ (SME-8 deadline-aware)
  dlqAt               DateTime?
  dlqReason           String?
  dlqRetries          Int        @default(0)

  // Escalation
  escalatedAt         DateTime?

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  revisions           ProposalRevision[]
  winLossEvents       WinLossEvent[]

  @@index([stage])
  @@index([clientEmail])
  @@index([deadline])
  @@index([createdAt])
  @@index([bidDecision])
}

model ProposalRevision {
  id           String    @id @default(cuid())
  proposalId   String
  version      Int
  draftText    String    @db.Text
  reviewNotes  String?   @db.Text
  agentFlags   Json?     // issues raised by review-agent
  triggeredBy  String?   // "review-agent" | userId
  createdAt    DateTime  @default(now())

  proposal     Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model WinLossEvent {
  id                       String          @id @default(cuid())
  proposalId               String
  outcome                  WinLossOutcome
  valueUsd                 Decimal?        @db.Decimal(14,2)
  conversionLagDays        Int?
  qualityScoreAtSubmission Int?
  revisionCycles           Int?
  pricingDeltaFromFloorPct Float?          // pricing_delta_from_floor_pct (SME-13)
  lossReason               String?
  notes                    String?         @db.Text
  linkedAt                 DateTime        @default(now())

  proposal                 Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([outcome])
  @@index([linkedAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  action      String
  userId      String?
  sessionId   String
  executionId Int?
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  execution Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([sessionId])
  @@index([createdAt])
}

model PromptVersion {
  id                     String   @id @default(cuid())
  agentId                String
  prompt                 String   @db.Text
  avgScore               Float    @default(0)
  runCount               Int      @default(0)
  active                 Boolean  @default(false)
  createdAt              DateTime @default(now())
  // AAS v4 Phase C — learning system tracking
  methodId               String   @default("failure_analysis") // which learning method produced this
  loopsWithoutImprovement Int     @default(0)                  // increments when avgScore stagnates
  quarantined            Boolean  @default(false)              // Phase 10: flagged for removal review
  quarantinedAt          DateTime?                             // when quarantine was set

  learningResults LearningMethodResult[]

  @@index([agentId, active])
  @@index([agentId, quarantined])
}

// AAS v4 Phase 08 — per-method learning effectiveness tracking
// Enables quarterly win-rate comparison and method deprioritisation
model LearningMethodResult {
  id            String   @id @default(cuid())
  methodId      String   // failure_analysis | success_deconstruction | anomaly_review | adversarial_audit
  agentId       String
  promptVersion PromptVersion @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId        String   // PromptVersion.id created by this cycle
  scoreBefore   Float
  scoreAfter    Float    @default(0)  // updated when enough runs accumulate post-cycle
  delta         Float    @default(0)  // scoreAfter - scoreBefore (updated retroactively)
  cadence       String   // micro | weekly | quarterly
  computedAt    DateTime @default(now())

  @@index([methodId])
  @@index([agentId])
  @@index([computedAt])
  @@index([cadence])
}

// Deployment FSM state tracking — v3/v4 Autonomous Platform spec
// One row per deployment attempt. State transitions enforced by lib/deployment/deployment.fsm.ts.
model DeploymentRecord {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique                  // client-generated UUID; dedup window: forever
  userId         String?
  executionId    Int?
  projectName    String
  provider       String                            // vercel | railway | render | github
  state          String   @default("queued")       // DeploymentState enum values
  url            String?                           // final deployment URL (set on active)
  errorMessage   String?  @db.Text
  metadata       Json     @default("{}")           // FSM transition history + provider-specific data
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([state])
  @@index([provider])
  @@index([createdAt])
}

model KitActivation {
  id        String   @id @default(cuid())
  kitId     String
  sessionId String
  plan      String   @default("free")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([kitId, sessionId])
  @@index([sessionId, active])
}

model TrendingItem {
  id               String   @id @default(cuid())
  title            String
  url              String?
  source           String   // 'hackernews' | 'ai_curated' | 'producthunt'
  category         String   // 'tool' | 'trend' | 'opportunity' | 'article'
  audience         String   @default("both") // 'freelancer' | 'solopreneur' | 'both'
  summary          String   @db.Text
  useCase          String   @db.Text
  tags             String[] @default([])
  hnScore          Int      @default(0)
  batchId          String   // groups items from same fetch run
  fetchedAt        DateTime @default(now())
  // AAS v4 Signal Object fields
  confidence       Float    @default(0.5)          // 0–1, required at every handoff
  causalMechanism  String?                          // null = kill; why this is happening
  regimeClass      String   @default("unknown")    // expansion|transition|contraction|unknown
  exploreOrExploit String   @default("E")          // E=explore, X=exploit
  saturationIndex  Float    @default(0.0)          // 0–1; >0.8 = hygiene, not advantage
  timingAdv        Float    @default(0.0)          // timing advantage score vs field consensus

  @@index([fetchedAt])
  @@index([batchId])
  @@index([category])
  @@index([regimeClass])
}

// AAS v4 — current system regime classification
model SystemRegime {
  id            String   @id @default(cuid())
  regimeClass   String   // expansion|transition|contraction|unknown
  confidence    Float    // 0–1, classification confidence
  triggerSource String   // scheduled|threshold_breach|manual|regime_shift
  indicators    Json     @default("{}") // raw signals used: signalDensity, trendSlope, anomalyRate, crDelta
  classifiedAt  DateTime @default(now())

  @@index([classifiedAt])
}

// AAS v4 — per-loop 5-dimensional Compound Rate snapshots
model CRSnapshot {
  id          String   @id @default(cuid())
  loopVersion Int
  sqi         Float    // Signal Quality Index (25%): avg score quality + full pipeline rate
  pAcc        Float    // Prediction Accuracy (30%): Brier-score-based pass/fail accuracy
  kPrec       Float    // Kill Precision (20%): ratio of completed full-pipeline runs
  evel        Float    // Execution Velocity (15%): runs/day vs 30d baseline
  lsm         Float    // Learning Speed Metric (10%): avg score delta per learning cycle
  cr          Float    // Compound Rate = weighted sum of above
  mCR         Float    // Meta-CR: CR delta vs prior snapshot (learning system health)
  regimeClass String   // regime at time of computation
  cadence     String   @default("scheduled") // micro | weekly | quarterly | scheduled | manual
  computedAt  DateTime @default(now())

  @@index([computedAt])
  @@index([loopVersion])
  @@index([cadence])
}

// ─── Workspace Intelligence Layer ─────────────────────────────────────────────

// Structured intelligence profile per workspace.
// Controls workspace-scoped idea generation, FORGE context injection,
// and per-workspace scheduled refresh cadence.
model WorkspaceIntelligenceProfile {
  id                    String    @id @default(cuid())
  workspaceId           String    @unique
  primaryIndustry       String    @default("unconfigured") // top-level taxonomy node
  subcategories         String[]  @default([])              // taxonomy leaf nodes
  targetMarket          String    @default("smb")           // smb|enterprise|consumer|mixed
  preferredRevenueModel String    @default("subscription")  // subscription|usage|one-time|hybrid
  buildComplexityPref   String    @default("mid")           // quick|mid|deep
  generationAggression  String    @default("balanced")      // conservative|balanced|aggressive
  refreshCadenceHours   Int       @default(24)              // per-workspace refresh interval
  enabledNiches         String[]  @default([])              // subset of 8 niches (empty = all)
  lastGeneratedAt       DateTime?
  generationCount       Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([primaryIndustry])
  @@index([lastGeneratedAt])
}

// Per-workspace AI-generated opportunity ideas with full lifecycle tracking.
// Separate from global TrendingItem — scoped to workspace intelligence profile.
model WorkspaceIdea {
  id               String    @id @default(cuid())
  workspaceId      String
  title            String
  niche            String    // maps to intelligence profile niche
  problem          String    @db.Text
  targetMarket     String
  revenueModel     String
  trendReason      String    @db.Text
  buildComplexity  String    @default("medium")           // low|medium|high
  tags             String[]  @default([])
  opportunityScore Int       @default(70)
  confidence       Float     @default(0.5)
  causalMechanism  String?
  regimeClass      String    @default("unknown")
  exploreOrExploit String    @default("E")               // E=explore, X=exploit
  saturationIndex  Float     @default(0.0)
  timingAdv        Float     @default(0.5)
  // Lifecycle
  status           String    @default("fresh")            // fresh|stale|archived|converted|bookmarked
  freshUntil       DateTime                               // TTL based on niche category
  convertedAt      DateTime?                              // when status set to converted
  executionId      Int?                                   // FK to Execution if converted to pipeline
  // Lineage
  batchId          String
  parentIdeaId     String?                                // if this is a re-generation of an older idea
  generationVersion Int      @default(1)
  // Deduplication
  contentHash      String                                 // sha256(title+problem) for exact dedup

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  execution  Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, freshUntil])
  @@index([workspaceId, niche])
  @@index([contentHash])
  @@index([batchId])
  @@index([createdAt])
}

// Per-workspace idea generation job queue for scheduler.
// Provides idempotency (batchId @unique) and concurrency control.
model WorkspaceGenerationJob {
  id             String    @id @default(cuid())
  workspaceId    String
  status         String    @default("queued")  // queued|running|done|failed
  batchId        String    @unique             // idempotency key — safe to retry
  ideasGenerated Int       @default(0)
  deDupedCount   Int       @default(0)
  errorMessage   String?   @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([createdAt])
}

// ─── Video Prompt Generator ───────────────────────────────────────────────────
// AI-generated 8-second UGC ad video prompts for NEXUS OS.
// Shot-level decomposition compatible with Nano Banana video generation model.

model VideoPrompt {
  id            String   @id @default(cuid())
  title         String                           // punchy 6-word max title
  hookType      String   @default("pain_point")  // pain_point | transformation | social_proof | curiosity | before_after
  platform      String   @default("tiktok")      // tiktok | reels | shorts | all
  targetICP     String?                           // freelancer | agency | founder | operator
  painPoint     String?                           // the specific pain addressed
  promptJson    String   @db.Text                // full shot-level JSON for Nano Banana
  voiceoverText String?  @db.Text                // extracted full VO script for quick copy
  ctaText       String?                           // extracted CTA line
  tags          String[] @default([])
  batchId       String?
  generatedBy   String   @default("manual")      // manual | scheduled
  isFavourite   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([hookType])
  @@index([targetICP])
  @@index([batchId])
  @@index([createdAt])
}

// ─── Image Prompt Generator ───────────────────────────────────────────────────
// AI-generated JSON image prompts for NEXUS OS brand / marketing visuals.
// Each prompt is a structured JSON doc describing a full visual composition.

model ImagePrompt {
  id           String   @id @default(cuid())
  title        String                          // short descriptive title
  category     String   @default("brand")     // brand | campaign | product | social | poster
  promptJson   String   @db.Text              // full structured JSON prompt
  tags         String[] @default([])
  batchId      String?                        // groups prompts from same generation run
  generatedBy  String   @default("manual")   // manual | scheduled
  isFavourite  Boolean  @default(false)
  imageData    String?  @db.Text   // base64-encoded generated image
  imageMime    String?             // e.g. "image/png"
  imageGenAt   DateTime?           // when image was last generated
  createdAt    DateTime @default(now())

  @@index([category])
  @@index([batchId])
  @@index([createdAt])
  @@index([isFavourite])
}

// ─── Workspace Integration Layer ──────────────────────────────────────────────
// OAuth-connected third-party integrations per workspace.
// Tokens are stored encrypted (AES-256-GCM via lib/encrypt.ts).
// provider: gmail | google-calendar | notion | hubspot | slack

model WorkspaceIntegration {
  id           String    @id @default(cuid())
  workspaceId  String
  provider     String    // gmail | google-calendar | notion | hubspot | slack
  accessToken  String    @db.Text  // encrypted
  refreshToken String?   @db.Text  // encrypted
  expiresAt    DateTime?
  scopes       String[]  @default([])
  accountEmail String?   // display: which account is connected
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId, enabled])
}

// ─── Client Agent Business Layer ──────────────────────────────────────────────

model ClientAgent {
  id              String    @id @default(cuid())
  workspaceId     String
  agentType       String    // email-triage | meeting-prep | followup-seq | loop-closer | context-brief | weekly-digest
  label           String?   // custom display name
  enabled         Boolean   @default(true)
  schedule        String    @default("weekly") // daily | weekly | manual
  deliveryMethod  String    @default("email")  // email | whatsapp | portal
  deliveryEmail   String?   // client's email for delivery
  deliveryPhone   String?   // client's WhatsApp number
  lastRunAt       DateTime?
  lastOutput      String?   @db.Text  // cached last agent output (markdown)
  outcomeMetric   String?   // e.g. "emails_triaged" — which outcome counter to increment
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs      ClientAgentJob[]

  @@index([workspaceId, enabled])
  @@index([agentType])
}

model ClientAgentJob {
  id            String    @id @default(cuid())
  clientAgentId String
  workspaceId   String
  status        String    @default("queued") // queued | running | done | failed | skipped
  inputPayload  String?   @db.Text  // JSON input context
  outputText    String?   @db.Text  // agent markdown output
  delivered     Boolean   @default(false)
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  clientAgent ClientAgent @relation(fields: [clientAgentId], references: [id], onDelete: Cascade)

  @@index([clientAgentId, status])
  @@index([workspaceId])
  @@index([createdAt])
}

// ─── Growth Engine ─────────────────────────────────────────────────────────────

/// Public shareable run card — created when a pipeline completes with a live URL.
/// Accessible at /s/[slug] without authentication.
model SharedRun {
  id           String   @id @default(cuid())
  slug         String   @unique  // short URL-safe string, e.g. "abc12"
  userId       String?
  projectName  String
  brief        String   @db.Text
  vertical     String   @default("saas")
  qaScore      Float?
  elapsedSec   Int?
  agentCount   Int      @default(23)
  fileCount    Int      @default(0)
  liveUrl      String?
  appRepoUrl   String?
  refCode      String?  // referral code at time of share (for attribution)
  viewCount    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([slug])
  @@index([userId])
  @@index([createdAt])
}

/// Per-user referral code. One code per user, generated on first use.
model ReferralCode {
  id          String   @id @default(cuid())
  userId      String   @unique
  code        String   @unique  // e.g. "NEXUS-A3X7"
  clicks      Int      @default(0)
  signups     Int      @default(0)
  conversions Int      @default(0)  // free→paid upgrades from referral
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
}
