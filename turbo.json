{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "ANTHROPIC_API_KEY",
        "GEMINI_API_KEY",
        "GEMINI_API_KEY1",
        "GEMINI_API_KEY2",
        "GEMINI_API_KEY3",
        "GEMINI_API_KEY4",
        "GEMINI_API_KEY5",
        "GROQ_API_KEY",
        "GROQ_API_KEY1",
        "GROQ_API_KEY2",
        "GROQ_API_KEY3",
        "GROQ_API_KEY4",
        "GROQ_API_KEY5",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "INTERNAL_NOTIFY_EMAIL",
        "RAZORPAY_KEY_ID",
        "RAZORPAY_KEY_SECRET",
        "NEXT_PUBLIC_RAZORPAY_KEY_ID",
        "WATI_API_KEY",
        "WATI_URL",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "NEXT_PUBLIC_APP_URL",
        "CRON_SECRET",
        "ALERT_PHONE",
        "ADMIN_EMAILS",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "GITHUB_TOKEN",
        "VERCEL_TOKEN",
        "VERCEL_TEAM_ID",
        "NEXT_PUBLIC_BRAND_NAME",
        "NEXT_PUBLIC_BRAND_VERSION",
        "NEXT_PUBLIC_BRAND_TAGLINE",
        "NEXT_PUBLIC_BRAND_DOMAIN",
        "NEXT_PUBLIC_BRAND_SUPPORT_EMAIL",
        "NEXT_PUBLIC_BRAND_COLOR"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    }
  }
}
