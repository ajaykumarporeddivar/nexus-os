{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @nexus-os/web build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "regions": ["sin1"],
  "crons": [
    { "path": "/api/cron/trending",    "schedule": "0 */6 * * *" },
    { "path": "/api/learning/cycle",   "schedule": "0 2 * * *" },
    { "path": "/api/monitor",          "schedule": "0 8 * * *" },
    { "path": "/api/eval",             "schedule": "0 3 * * 1" },
    { "path": "/api/cron/lead-dlq-retry", "schedule": "0 * * * *" },
    { "path": "/api/cron/lead-digest",    "schedule": "0 9 * * 1" },
    { "path": "/api/cron/lead-retention", "schedule": "0 0 * * *" },
    { "path": "/api/cron/growth-drip",   "schedule": "0 10 * * *" },
    { "path": "/api/cron/self-heal",     "schedule": "*/30 * * * *" },
    { "path": "/api/cron/reactivate",     "schedule": "0 10 1 * *"  },
    { "path": "/api/cron/lead-sequence",          "schedule": "0 * * * *"   },
    { "path": "/api/cron/daily-niche-generator",  "schedule": "0 1 * * *"   }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",     "value": "nosniff" },
        { "key": "X-Frame-Options",             "value": "DENY" },
        { "key": "Referrer-Policy",             "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",          "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' checkout.razorpay.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src 'self' fonts.gstatic.com; img-src 'self' data: blob: lh3.googleusercontent.com; connect-src 'self' https://api.anthropic.com https://checkout.razorpay.com https://api.razorpay.com https://*.upstash.io https://api.resend.com https://live-mt-server.wati.io; frame-src checkout.razorpay.com"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type",   "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control",  "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/og-image.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }]
    }
  ]
}
