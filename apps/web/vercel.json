{
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm build --filter=@nexus-os/web",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && pnpm install",
  "crons": [
    { "path": "/api/cron/trending",            "schedule": "0 6 * * *" },
    { "path": "/api/learning/cycle",           "schedule": "0 2 * * *" },
    { "path": "/api/learning/weekly",          "schedule": "0 3 * * 1" },
    { "path": "/api/learning/update-deltas",   "schedule": "0 4 * * *" },
    { "path": "/api/monitor",                  "schedule": "0 8 * * *" },
    { "path": "/api/eval",                     "schedule": "0 5 * * 1" },
    { "path": "/api/regime",                   "schedule": "0 1 * * *" },
    { "path": "/api/agent/run",                "schedule": "0 7 * * *" },
    { "path": "/api/cron/workspace-scheduler",   "schedule": "0 9 * * *" },
    { "path": "/api/cron/subscription-expiry",  "schedule": "0 0 * * *" },
    { "path": "/api/cron/activate",             "schedule": "0 9 * * *" },
    { "path": "/api/cron/digest",               "schedule": "0 8 1 * *" },
    { "path": "/api/cron/winback",              "schedule": "0 10 * * 1" },
    { "path": "/api/cron/lead-dlq-retry",      "schedule": "0 * * * *"  },
    { "path": "/api/cron/lead-digest",         "schedule": "0 9 * * 1"  },
    { "path": "/api/cron/lead-retention",      "schedule": "0 0 * * *"  },
    { "path": "/api/image-prompts/batch",               "schedule": "0 10 * * *" },
    { "path": "/api/video-prompts/batch",               "schedule": "0 11 * * *" },
    { "path": "/api/cron/proposal-deadline-monitor",    "schedule": "0 * * * *"  },
    { "path": "/api/cron/proposal-digest",              "schedule": "0 9 * * 1"  }
  ],
  "functions": {
    "app/api/cron/lead-dlq-retry/route.ts": { "maxDuration": 60 },
    "app/api/cron/lead-digest/route.ts":    { "maxDuration": 30 },
    "app/api/cron/lead-retention/route.ts": { "maxDuration": 30 },
    "app/api/leads/score/route.ts":         { "maxDuration": 30 },
    "app/api/leads/route.ts":                                { "maxDuration": 30 },
    "app/api/proposals/route.ts":                           { "maxDuration": 60 },
    "app/api/proposals/[id]/draft/route.ts":                { "maxDuration": 120 },
    "app/api/cron/proposal-deadline-monitor/route.ts":      { "maxDuration": 60 },
    "app/api/cron/proposal-digest/route.ts":                { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-Content-Type-Options",     "value": "nosniff" },
        { "key": "Referrer-Policy",            "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",         "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://checkout.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com https://checkout.razorpay.com; font-src 'self' fonts.gstatic.com; img-src 'self' data: blob: https://*.razorpay.com; connect-src 'self' https://api.anthropic.com https://image.pollinations.ai https://api-inference.huggingface.co https://api.replicate.com https://api.razorpay.com https://lumberjack.razorpay.com;"
        }
      ]
    }
  ]
}
