{
  "name": "nexus-os",
  "version": "11.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "setup":    "node scripts/setup.mjs",
    "setup:ci": "node scripts/setup.mjs --yes",
    "check":    "node scripts/setup.mjs --check",
    "dev":      "turbo dev",
    "build":    "turbo build",
    "test":     "turbo test",
    "lint":     "turbo lint",
    "db:push":  "prisma db push",
    "db:seed":  "tsx prisma/seed.ts",
    "db:studio":"prisma studio",
    "tsc":      "tsc --noEmit -p apps/web/tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "prisma": "5.22.0",
    "@types/node": "^20",
    "tsx": "^4.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  }
}
