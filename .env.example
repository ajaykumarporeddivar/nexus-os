# ─────────────────────────────────────────────────────────────────────────────
# NEXUS OS — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
#
# QUICKSTART: run `node scripts/setup.mjs` — it fills this in for you.
#
# TIERS:
#   [REQUIRED]  Pipeline won't work without these
#   [OPTIONAL]  Enhances functionality but not blocking
#   [ADVANCED]  Production/scale features — skip for local dev
# ─────────────────────────────────────────────────────────────────────────────


# ── DATABASE ─────────────────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL. Free tier: https://neon.tech (5GB, no credit card)
# Copy the "Connection string" from Neon dashboard.
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require


# ── AUTH ──────────────────────────────────────────────────────────────────────
# [REQUIRED] Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# [REQUIRED] Your app URL. Localhost for dev, real domain for prod.
NEXTAUTH_URL=http://localhost:3000

# [OPTIONAL] Google OAuth — enables "Sign in with Google"
# Setup: https://console.cloud.google.com → APIs → Credentials → Create OAuth 2.0 Client
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── AI PROVIDERS ─────────────────────────────────────────────────────────────
# Chain: Anthropic → Gemini → Groq. Each is a fallback for the previous.
# Minimum: one of the three. Recommended: all three for reliability.

# [REQUIRED] Anthropic — primary, best quality for FORGE agents
# Get: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# [RECOMMENDED] Groq — fast, free tier (14,400 req/day)
# Get: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_...

# Add up to 50 Groq keys for rotation (GROQ_API_KEY1 … GROQ_API_KEY50)
# GROQ_API_KEY1=gsk_...
# GROQ_API_KEY2=gsk_...

# [RECOMMENDED] Google Gemini — 1M context window, free tier
# Get: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=AIzaSy...

# Add up to 50 Gemini keys for rotation (GEMINI_API_KEY1 … GEMINI_API_KEY50)
# GEMINI_API_KEY1=AIzaSy...
# GEMINI_API_KEY2=AIzaSy...


# ── EMAIL ─────────────────────────────────────────────────────────────────────
# [OPTIONAL] Resend — sends completion emails, growth drips, proposals
# Free tier: 100 emails/day, 3,000/month. Get: https://resend.com
RESEND_API_KEY=re_...

# [OPTIONAL] From address for outbound emails
EMAIL_FROM=NEXUS OS <noreply@yourdomain.com>

# [OPTIONAL] Where to send ops digest emails (proposal-digest cron)
OPS_DIGEST_EMAIL=
NEXUS_ADMIN_EMAIL=


# ── APP ───────────────────────────────────────────────────────────────────────
# [REQUIRED] Public app URL — used in emails, OG tags, share pages
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [OPTIONAL] Brand overrides — shown in UI and emails
NEXT_PUBLIC_BRAND_NAME=NEXUS OS
NEXT_PUBLIC_BRAND_TAGLINE=AI Delivery Infrastructure
NEXT_PUBLIC_BRAND_DOMAIN=nexus-os.ai


# ── SECURITY ──────────────────────────────────────────────────────────────────
# [REQUIRED] Secures cron endpoints — set to any random string
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CRON_SECRET=

# [REQUIRED] Encrypts API keys stored in DB
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=


# ── DEPLOYMENT ────────────────────────────────────────────────────────────────
# [OPTIONAL] Vercel — enables one-click deploy from pipeline
# Get: https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# [OPTIONAL] GitHub — creates repos for each pipeline run
# Get: https://github.com/settings/tokens (needs repo scope)
GITHUB_TOKEN=

# [OPTIONAL] Railway — alternative hosting for BUILD outputs
RAILWAY_TOKEN=

# [OPTIONAL] Render — alternative hosting
RENDER_API_KEY=


# ── BILLING ───────────────────────────────────────────────────────────────────
# [OPTIONAL] Razorpay — payment processing (India)
# Get: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...


# ── STORAGE ───────────────────────────────────────────────────────────────────
# [OPTIONAL] S3-compatible object storage for build artifacts
# Works with AWS S3, Cloudflare R2, Backblaze B2
S3_BUCKET=nexus-os-artifacts
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1


# ── CACHE / RATE LIMITING ─────────────────────────────────────────────────────
# [OPTIONAL] Upstash Redis — distributed rate limiting in production
# Free tier: 10,000 req/day. Get: https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# [OPTIONAL] Redis (self-hosted or Railway)
REDIS_URL=


# ── NOTIFICATIONS ─────────────────────────────────────────────────────────────
# [OPTIONAL] WhatsApp via WATI — sends alerts and pipeline notifications
WATI_API_KEY=
WATI_URL=https://live-mt-server.wati.io

# [OPTIONAL] Alert phone for critical errors (WhatsApp)
ALERT_PHONE=+91...

# [OPTIONAL] Internal team notification email
INTERNAL_NOTIFY_EMAIL=

# [OPTIONAL] Demo booking webhook (Zapier, Make, n8n)
DEMO_WEBHOOK_URL=


# ── MEDIA GENERATION ─────────────────────────────────────────────────────────
# [OPTIONAL] Higgsfield AI — video generation for content engine
# Get: https://higgsfield.ai
HIGGSFIELD_API_KEY=


# ── ADMIN ─────────────────────────────────────────────────────────────────────
# [OPTIONAL] Email addresses with admin access (comma-separated)
ADMIN_EMAILS=

# [OPTIONAL] NODE_ENV override
# NODE_ENV=development
