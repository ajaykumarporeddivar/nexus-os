# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/nexus_os

# Auth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=

# Storage (S3 compatible)
S3_BUCKET=nexus-os-artifacts
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Upstash Redis (burst rate limiting + quota — replaces in-memory fallback in prod)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# API key encryption (generate: openssl rand -hex 32)
ENCRYPTION_SECRET=

# Webhooks
DEMO_WEBHOOK_URL=

# Higgsfield AI (image generation — https://higgsfield.ai)
HIGGSFIELD_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
